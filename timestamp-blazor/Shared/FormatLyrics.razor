@inject IJSRuntime JS
@using LyricsFormatting

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
  <MudPaper Elevation="0" Class="d-flex align-center ga-2 mb-4" Style="background:transparent;">
    <MudText Typo="Typo.h4" Class="mr-auto">Lyrics formatter</MudText>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="LoadExample">Load example</MudButton>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Undo" Disabled="@(!UndoAvailable)" OnClick="Undo">Undo</MudButton>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear" OnClick="Clear">Clear</MudButton>
  </MudPaper>

  <MudPaper Elevation="2" Class="pa-4">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap">
      <MudSelect T="string" @bind-Value="Encoding" Label="Encoding" Variant="Variant.Outlined" Dense="true" Style="min-width:260px;">
        <MudSelectItem T="string" Value="@("unicode")">Unicode (UTF-8)</MudSelectItem>
        <MudSelectItem T="string" Value="@("romanian")">Romanian (diacritics for DualDisplay)</MudSelectItem>
        <MudSelectItem T="string" Value="@("latin1")">ISO-8859-1</MudSelectItem>
      </MudSelect>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="OnProcess">Process</MudButton>
      <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="OnCopy">Copy</MudButton>
    </MudStack>

    <MudStack Class="mb-2">
      <MudStack Row="true" Spacing="1" Class="flex-wrap" aria-label="Song structure">
        @{ var verseCounter = 0; }
        @for (int i = 0; i < _blocks.Count; i++)
        {
          var idx = i;
          var b = _blocks[idx];
          <MudChip T="string" Color="@ChipColor(b)" Variant="@(b.Added ? Variant.Outlined : Variant.Filled)" OnClick="@(() => SelectBlock(idx))">
            @(b.Kind == BlockKind.Verse ? $"Verse {++verseCounter}" : b.Kind == BlockKind.Chorus ? "Chorus" : "Section")
          </MudChip>
        }
      </MudStack>
      <MudText Typo="Typo.body2" Color="Color.Secondary">@_legend</MudText>
    </MudStack>

    <MudTextField @ref="_textFieldRef" T="string" Value="@Lyrics" ValueChanged="OnLyricsChanged" Lines="16" Variant="Variant.Outlined"
                  Spellcheck="false" aria-label="Lyrics" Placeholder="Paste the song lyrics here, choose an encoding, then press Process."
                  FullWidth="true" Class="mb-4" />

    <MudExpansionPanels Class="mb-4">
      <MudExpansionPanel Text="Custom corrections (optional)">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">One per line, in the form word=cuvânt. Applied over the built-in dictionary.</MudText>
        <MudTextField T="string" @bind-Value="CustomCorrections" Lines="5" Variant="Variant.Outlined" Spellcheck="false"
                      aria-label="Custom corrections" Placeholder="lumina=lumină" FullWidth="true" />
      </MudExpansionPanel>
    </MudExpansionPanels>

    <MudStack Row="true" Spacing="4" Class="flex-wrap">
      <MudText Typo="Typo.body2">@_status</MudText>
      <MudText Typo="Typo.body2">Characters: <b>@_charCount</b></MudText>
      <MudText Typo="Typo.body2">Lines: <b>@_lineCount</b></MudText>
    </MudStack>
  </MudPaper>
</MudContainer>

@code {
    [Parameter] public string InitialLyrics { get; set; }

    MudTextField<string> _textFieldRef = null!;
    string Lyrics;
    string Encoding = "romanian";
    string CustomCorrections = string.Empty;

    List<LyricsBlock> _blocks = new();
    string _legend = "Select a section to find it in the text.";
    string _status = string.Empty;
    int _charCount = 0;
    int _lineCount = 0;

    readonly List<string> undoStack = new();
    bool UndoAvailable => undoStack.Count > 0;

    protected override void OnInitialized()
    {
        Lyrics = InitialLyrics ?? string.Empty;
        UpdateCounts();
    }

    void OnLyricsChanged(string value)
    {
        Lyrics = value ?? string.Empty;
        _blocks.Clear();
        _legend = "Select a section to find it in the text.";
        UpdateCounts();
    }

    void UpdateCounts()
    {
        _charCount = string.IsNullOrEmpty(Lyrics) ? 0 : Lyrics.Length;
        _lineCount = string.IsNullOrEmpty(Lyrics) ? 0 : Lyrics.Split("\n---").Length;
    }

    void LoadExample()
    {
        var ex = "1. First verse line\n2. Second line\n\n[Chorus]\nChorus line 1\nChorus line 2\n\n3. Third verse line";
        Lyrics = ex;
        UpdateCounts();
        _status = "Loaded an example. Press Process to format it.";
    }

    void Clear()
    {
        Lyrics = string.Empty;
        _blocks.Clear();
        _legend = "";
        _status = string.Empty;
        UpdateCounts();
    }

    void Undo()
    {
        if (undoStack.Count == 0) return;
        Lyrics = undoStack.Last();
        undoStack.RemoveAt(undoStack.Count - 1);
        _blocks.Clear();
        UpdateCounts();
    }

    async Task OnCopy()
    {
        if (string.IsNullOrEmpty(Lyrics))
        {
            _status = "There is nothing to copy yet.";
            return;
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Lyrics);
        _status = $"Copied {_charCount} characters.";
    }

    void OnProcess()
    {
        if (string.IsNullOrWhiteSpace(Lyrics))
        {
            _status = "Paste some lyrics first.";
            return;
        }
        undoStack.Add(Lyrics);
        var res = LyricsFormatter.Process(Lyrics, Encoding, ParseCustomCorrections());
        if (res.Empty)
        {
            _status = "Could not find any lyrics to process.";
            return;
        }
        Lyrics = res.Text;
        _blocks = res.Blocks;
        _legend = res.Added > 0 ? "Dashed sections are choruses that were added." : "Select a section to find it in the text.";
        _status = res.Summary;
        UpdateCounts();
        StateHasChanged();
    }

    Dictionary<string, string>? ParseCustomCorrections()
    {
        if (string.IsNullOrWhiteSpace(CustomCorrections)) return null;
        var map = new Dictionary<string, string>();
        foreach (var line in CustomCorrections.Split('\n'))
        {
            var i = line.IndexOf('=');
            if (i < 1) continue;
            var key = line[..i].Trim();
            var value = line[(i + 1)..].Trim();
            if (key.Length > 0 && value.Length > 0) map[key] = value;
        }
        return map.Count > 0 ? map : null;
    }

    async Task SelectBlock(int index)
    {
        if (index < 0 || index >= _blocks.Count) return;
        var blk = _blocks[index];
        await _textFieldRef.FocusAsync();
        await _textFieldRef.SelectRangeAsync(blk.Start, blk.End);
    }

    Color ChipColor(LyricsBlock block) => block.Kind switch
    {
        BlockKind.Verse => Color.Primary,
        BlockKind.Chorus => Color.Secondary,
        _ => Color.Default
    };
}
